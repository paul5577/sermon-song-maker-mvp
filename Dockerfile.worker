FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg fonts-noto-cjk && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json ./
COPY lib ./lib
COPY scripts ./scripts
COPY public/templates ./public/templates
RUN mkdir -p .data/projects .data/uploads .data/work public/generated
ENV RENDER_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
CMD ["node", "scripts/render-worker.mjs"]
